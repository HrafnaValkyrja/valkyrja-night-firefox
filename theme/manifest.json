{
  "manifest_version": 2,
  "name": "Valkyrja Night",
  "version": "1.1.0",
  "description": "Dark Firefox theme: night-sky indigo title bar, true-black toolbar and sidebar, cyan active tab and focus. Colours only, no code.",
  "browser_specific_settings": {
    "gecko": {
      "id": "valkyrja-night-firefox@hrafnavalkyrja.github.io",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "theme": {
    "colors": {
      "frame": "#131029",
      "frame_inactive": "#131029",
      "tab_background_text": "#dce8f5",
      "tab_selected": "#0a0818",
      "tab_text": "#dce8f5",
      "tab_line": "#4fe0ff",
      "tab_loading": "#4fe0ff",
      "tab_background_separator": "#5b4bd659",
      "toolbar": "#000000",
      "toolbar_text": "#dce8f5",
      "icons": "#8fd3ff",
      "icons_attention": "#4fe0ff",
      "toolbar_top_separator": "#5b4bd659",
      "toolbar_bottom_separator": "#5b4bd659",
      "toolbar_vertical_separator": "#5b4bd640",
      "toolbar_field": "#0a0818",
      "toolbar_field_text": "#dce8f5",
      "toolbar_field_border": "#5b4bd673",
      "toolbar_field_focus": "#000000",
      "toolbar_field_text_focus": "#dce8f5",
      "toolbar_field_border_focus": "#4fe0ff",
      "toolbar_field_highlight": "#4fe0ff55",
      "toolbar_field_highlight_text": "#dce8f5",
      "button_background_hover": "#8fd3ff1f",
      "button_background_active": "#8fd3ff33",
      "popup": "#0a0818",
      "popup_text": "#dce8f5",
      "popup_border": "#5b4bd6",
      "popup_highlight": "#4fe0ff33",
      "popup_highlight_text": "#dce8f5",
      "sidebar": "#000000",
      "sidebar_text": "#dce8f5",
      "sidebar_border": "#5b4bd659",
      "sidebar_highlight": "#4fe0ff33",
      "sidebar_highlight_text": "#dce8f5",
      "ntp_background": "#000000",
      "ntp_text": "#dce8f5",
      "ntp_card_background": "#0a0818"
    },
    "properties": {
      "color_scheme": "dark",
      "content_color_scheme": "dark"
    }
  }
}
